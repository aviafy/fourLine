# Set before build. Use the canonical HTTPS origin for the deployed website.
SITE_URL=
SITE_INDEXABLE=false
FOURLINE_PHONE=
FOURLINE_EMAIL=

# Set on the server only. Keep production values in the host's secret store.
RESEND_API_KEY=
PROPOSAL_FROM_EMAIL=
PROPOSAL_TO_EMAIL=

# Set only when the ingress overwrites this header with a verified client IP.
PROPOSAL_TRUSTED_IP_HEADER=
