# Set before build. Use the canonical HTTPS origin without a path.
# On Vercel, enable indexing only for the Production environment.
SITE_URL=
SITE_INDEXABLE=false
# Optional overrides for the public contacts. Separate telephone numbers with commas.
FOURLINE_PHONE=
FOURLINE_EMAIL=

# Set on the server only. Keep production values in the host's secret store.
RESEND_API_KEY=
PROPOSAL_FROM_EMAIL=
PROPOSAL_TO_EMAIL=

# Set only when the ingress overwrites this header with a verified client IP.
PROPOSAL_TRUSTED_IP_HEADER=
